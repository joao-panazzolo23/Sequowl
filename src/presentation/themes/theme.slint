import { ButtonStyle } from "../models/button-style.slint";
import { CardStyle } from "../models/card-style.slint";
import { EditorStyle } from "../models/editor-style.slint";
import { InputStyle } from "../models/input-style.slint";
import { TextStyle } from "../models/text-style.slint";
import { TableStyle } from "../models/table-style.slint";
import { AppRadius } from "../tokens/app-radius.slint";

export struct ThemeColors {
    background: color,
    panel: color,
    surface: color,
    surface-hover: color,
    surface-selected: color,
    icons: color,
    border: color,
    border-subtle: color,
    text-primary: color,
    text-secondary: color,
    text-muted: color,
    accent: color,
    accent-hover: color,
    success: color,
    warning: color,
    error: color,
}

export struct ThemeSpacings {
    border-width: length,
    extra-small: length,
    small: length,
    medium: length,
    large: length,
    extra-large: length,
    extra-extra-large: length,
}

export struct TypographyStyles {
    title-font: string,
    body-font: string,
    title-size: length,
    subtitle-size: length,
    body-size: length,
    caption-size: length,
}

export struct AppTheme {
    colors: ThemeColors,
    spacings: ThemeSpacings,
    typography: TypographyStyles,
    button: ButtonStyle,
    button-secondary: ButtonStyle,
    card: CardStyle,
    input: InputStyle,
    table: TableStyle,
    editor: EditorStyle,
    text-title: TextStyle,
    text-body: TextStyle,
    text-secondary: TextStyle,
    text-caption: TextStyle,
}

