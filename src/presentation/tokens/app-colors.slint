export global AppColors {
    // Backgrounds
    out property <color> background: #1E1E21;
    out property <color> panel:#252529;
    out property <color> surface: #2B2B30;
    out property <color> surface-hover: #29292d;
    out property <color> surface-selected: #303035;
    out property <color> icons: #f0f0f0;

    // Borders
    out property <color> border:  #3A3A40;
    out property <color> border-subtle: #29292d;

    // Text
    out property <color> text-primary: #f4f4f5;
    out property <color> text-secondary: #a1a1aa;
    out property <color> text-muted: #71717a;

    // Accent
    out property <color> accent: #9c00f6;

    // SQL syntax
    out property <color> syntax-plain: #f4f4f5;
    out property <color> syntax-keyword: #c77dff;
    out property <color> syntax-function: #7cc4ff;
    out property <color> syntax-number: #ffb86c;
    out property <color> syntax-string: #a5e075;
    out property <color> syntax-identifier: #f4f4f5;
    out property <color> syntax-quoted-identifier: #a5e075;
    out property <color> syntax-punctuation: #a1a1aa;
    out property <color> syntax-comment: #6a6a76;
    out property <color> syntax-type: #7fd6d1;

    // SQL editor chrome
    out property <color> editor-surface: #1e1e21;
    out property <color> editor-gutter: #71717a;
    out property <color> editor-caret: #c77dff;
    out property <color> editor-selection: #3b2e59;
    out property <color> editor-current-line: #212127;
    out property <color> diagnostic-error: #ef4444;
    out property <color> diagnostic-warning: #f59e0b;
    out property <color> diagnostic-info: #7cc4ff;
}
