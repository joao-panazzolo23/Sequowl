import { AboutSlint, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { HorizontalSplitter } from "../../../shared/horizontal-splitter.slint";
import { VerticalSplitter } from "../../../shared/vertical-splitter.slint";
import { SqlEditor } from "../../sql-editor/components/sql-editor.slint";
import {
    RadiusTokens,
    SpacingTokens,
} from "../../../tokens/spacing-tokens.slint";
import { ColorTokens } from "../../../tokens/colors-tokens.slint";
import { Terminal } from "../../terminal/components/terminal.slint";
import { SidebarPanel } from "sidebar-panel.slint";
import { PanelPage } from "../enums/panel-page.slint";
import { DatabaseExplorer } from "database-area.slint";
export component MainArea inherits Rectangle {
    in-out property <length> panel-width: 240px;
    in-out property <length> editor-height: 400px;
    in-out property <PanelPage> selected-page: PanelPage.Databases;

    HorizontalLayout {
        padding-top: SpacingTokens.large;
        spacing: 0;

        SidebarPanel {
            component-width: root.panel-width;

            ///todo: shitty code. it would be nice to have polimorphism here.
            if root.selected-page == PanelPage.Databases: DatabaseExplorer {

                databases: [
                    {
                        name: "postgres",
                        schemas: [
                            {
                                name: "public",
                                tables: [
                                    {
                                        name: "users",
                                        columns: [
                                            {
                                                name: "id",
                                                data-type: "uuid",
                                                is-nullable: false,
                                                is-primary-key: true,
                                                default-value: ""
                                            },
                                            {
                                                name: "name",
                                                data-type: "varchar(255)",
                                                is-nullable: false,
                                                is-primary-key: false,
                                                default-value: ""
                                            },
                                            {
                                                name: "email",
                                                data-type: "varchar(255)",
                                                is-nullable: false,
                                                is-primary-key: false,
                                                default-value: ""
                                            }
                                        ]
                                    },
                                    {
                                        name: "orders",
                                        columns: [
                                            {
                                                name: "id",
                                                data-type: "uuid",
                                                is-nullable: false,
                                                is-primary-key: true,
                                                default-value: ""
                                            },
                                            {
                                                name: "user_id",
                                                data-type: "uuid",
                                                is-nullable: false,
                                                is-primary-key: false,
                                                default-value: ""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                name: "auth",
                                tables: [
                                    {
                                        name: "sessions",
                                        columns: [
                                            {
                                                name: "id",
                                                data-type: "uuid",
                                                is-nullable: false,
                                                is-primary-key: true,
                                                default-value: ""
                                            },
                                            {
                                                name: "user_id",
                                                data-type: "uuid",
                                                is-nullable: false,
                                                is-primary-key: false,
                                                default-value: ""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        name: "analytics",
                        schemas: [
                            {
                                name: "public",
                                tables: [
                                    {
                                        name: "events",
                                        columns: [
                                            {
                                                name: "id",
                                                data-type: "bigint",
                                                is-nullable: false,
                                                is-primary-key: true,
                                                default-value: ""
                                            },
                                            {
                                                name: "event_name",
                                                data-type: "text",
                                                is-nullable: false,
                                                is-primary-key: false,
                                                default-value: ""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ];
                width: parent.width;
                height: parent.height;
                background: Colors.red;
            }

            if root.selected-page == PanelPage.QueryHistory: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Colors.blue;
            }
        }

        //tem uns bugzinhos visuais nessa tela, provavelmente pq aq o max eh um valor disparelho em relacao ao
        // max de baixo, verificar dps
        HorizontalSplitter {
            moved-by(delta) => {
                root.panel-width = max(
                    180px,
                    min(
                        500px,
                        root.panel-width + delta));
            }
        }

        // Workspace
        VerticalLayout {
            horizontal-stretch: 1;

            SqlEditor {
                editor-height: editor-height;
            }

            // Splitter
            VerticalSplitter {
                moved-by(delta) => {
                    root.editor-height = max(
                        150px,
                        root.editor-height + delta);
                }
            }

            Terminal { }
        }
    }
}
